# Copie para .env.local e preencha com os valores reais (nunca commitar .env.local)

# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (webhook). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# Asaas — https://www.asaas.com (Integrações → Chave de API)
# Sandbox: https://api-sandbox.asaas.com/v3 | Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Mesmo valor configurado em: Asaas → Integrações → Webhooks → "Token de autenticação"
ASAAS_WEBHOOK_TOKEN=

# Abre/fecha as vendas na página /pricing ("true" para liberar o checkout)
NEXT_PUBLIC_SALES_OPEN=false

# Google Gemini (importação de edital por IA)
GEMINI_API_KEY=

# Google Analytics (mantido do site atual)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Y9BH2YB009
